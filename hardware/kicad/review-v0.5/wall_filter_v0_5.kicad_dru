(version 1)

(rule "L or L_FUSED to N clearance"
  (constraint clearance (min 3.2mm))
  (condition "(((A.NetName == 'L_IN') || (A.NetName == 'L_FUSED')) && (B.NetName == 'N')) || (((B.NetName == 'L_IN') || (B.NetName == 'L_FUSED')) && (A.NetName == 'N'))"))

(rule "Mains copper to board edge"
  (constraint edge_clearance (min 2.0mm))
  (condition "A.Type == 'Track' || A.Type == 'Via' || A.Type == 'Pad'"))
